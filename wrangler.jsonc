{
  "name": "northfold",
  "compatibility_date": "2026-10-01",
  // Pages are prerendered to dist/<lang>/<path>/index.html; anything else falls back to the app shell.
  "assets": { "directory": "dist", "not_found_handling": "404-page", "html_handling": "drop-trailing-slash" },
  "routes": [{ "pattern": "northfold.tahamukhtar.com", "custom_domain": true }]
}
